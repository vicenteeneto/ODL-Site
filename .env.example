# ---------------------------------------------------------------------------
# Avaliações do Google em tempo real
#
# 1. Acesse https://console.cloud.google.com/
# 2. Crie um projeto e ative a "Places API (New)"
# 3. Em "Credenciais", gere uma chave de API
# 4. Restrinja a chave: Aplicativo = Endereços IP (servidor) e API = Places API (New)
# 5. Cole a chave abaixo, no arquivo .env.local (NÃO no .env.example)
#
# Sem essa chave o site continua funcionando: a seção de avaliações usa os
# depoimentos de reserva que estão no código.
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# Place ID do perfil "O Doutor Limpeza" em Rondonópolis-MT (já conferido)
GOOGLE_PLACE_ID="ChIJO5SMIDfJeZMR5Th-kDBhMeM"
